<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgriConnect.CartPage"
             Title="Mon Panier"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="White" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ImageButton Source="back_icon.png"
                         BackgroundColor="Transparent"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnBackClicked"
                         VerticalOptions="Center">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#x2190;" Color="Black" Size="24" />
                </ImageButton.Source>
            </ImageButton>
            <Label Grid.Column="1"
                   Text="Mon Panier"
                   TextColor="Black"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="-40,0,0,0"/>
        </Grid>

        <!-- Cart Items -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding CartItems}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="10" Margin="0,5" Padding="10" HasShadow="True" BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Frame CornerRadius="8" HeightRequest="60" WidthRequest="60" Padding="0" IsClippedToBounds="True">
                                <Image Source="{Binding Image}" Aspect="AspectFill"/>
                            </Frame>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{Binding Price}" TextColor="Gray"/>
                            </VerticalStackLayout>

                            <ImageButton Grid.Column="2"
                                         BackgroundColor="Transparent"
                                         Clicked="OnRemoveClicked"
                                         CommandParameter="{Binding .}">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="&#x1F5D1;" Color="Red" Size="20" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Votre panier est vide" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Footer -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="20" RowDefinitions="Auto,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <Label Text="Total:" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                <Label Text="{Binding TotalText}" Grid.Column="1" FontSize="18" FontAttributes="Bold" TextColor="#00C853"/>
            </Grid>
            
            <Button Grid.Row="1"
                    Text="Passer la commande"
                    BackgroundColor="#00C853"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Clicked="OnCheckoutClicked"/>
        </Grid>

    </Grid>
</ContentPage>
