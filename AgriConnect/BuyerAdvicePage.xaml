<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgriConnect.BuyerAdvicePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="White" HeightRequest="60" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <ImageButton Source="back_icon.png"
                         BackgroundColor="Transparent"
                         HeightRequest="30"
                         WidthRequest="30"
                         Clicked="OnBackClicked"
                         VerticalOptions="Center">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#x2190;" Color="#00C853" Size="30" />
                </ImageButton.Source>
            </ImageButton>

            <Label Grid.Column="1" 
                   Text="Conseils pour Achéteurs" 
                   TextColor="Black" 
                   FontSize="18" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center" />
                   
            <ImageButton Grid.Column="2" Source="notification_icon.png" HeightRequest="24" WidthRequest="24" VerticalOptions="Center">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F514;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="30">
                
                <!-- Saison des produits -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <Image Source="calendar_icon.png" HeightRequest="50" WidthRequest="50" VerticalOptions="Start">
                         <Image.Source>
                            <FontImageSource Glyph="&#x1F4C5;" Color="#00C853" Size="50" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout Grid.Column="1" Spacing="10">
                        <Label Text="Saison des produits" FontSize="16" TextColor="#333333" />
                        <Label Text="Tomates : toutes l'années ." FontSize="14" TextColor="Black" />
                        <Label Text="Maïs : JUILLET, AOÛT." FontSize="14" TextColor="Black" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Consigne -->
                <Label Text="CONSIGNE POUR MIEUX ACHETER" 
                       FontSize="16" 
                       TextColor="Black" 
                       HorizontalOptions="Center" 
                       Margin="0,20,0,10"/>

                <VerticalStackLayout Spacing="20">
                    <!-- Step 1 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Image Source="flag_icon.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Start">
                             <Image.Source>
                                <FontImageSource Glyph="&#x2691;" Color="#00C853" Size="30" />
                            </Image.Source>
                        </Image>
                        <Label Text="connectez vous a votre compte sur la liste des produit affiché, cliqué sur le produit a acheter, cela vous dirigera sur le détail du produit." 
                               FontSize="14" 
                               TextColor="Black" />
                    </Grid>

                    <!-- Step 2 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Image Source="flag_icon.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Start">
                             <Image.Source>
                                <FontImageSource Glyph="&#x2691;" Color="#00C853" Size="30" />
                            </Image.Source>
                        </Image>
                        <Label Text="sur la page de description, cliquez sur le boutton contactez le vendeur puis effectuez la transaction" 
                               FontSize="14" 
                               TextColor="Black" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" HeightRequest="60" BackgroundColor="White">
            <BoxView Grid.ColumnSpan="4" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Start" />

            <ImageButton Grid.Column="0" Source="home_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" Clicked="OnHomeClicked">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F3E0;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>

            <ImageButton Grid.Column="1" Source="chat_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" Clicked="OnChatClicked">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F4AC;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>

            <ImageButton Grid.Column="2" Source="cart_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" Clicked="OnCartClicked">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F6D2;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>

            <ImageButton Grid.Column="3" Source="profile_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F464;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>
    </Grid>
</ContentPage>
