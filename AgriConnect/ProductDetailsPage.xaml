<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Converters="clr-namespace:AgriConnect.Converters"
             x:Class="AgriConnect.ProductDetailsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="20" BackgroundColor="White">
            <ImageButton Source="back_icon.png"
                         BackgroundColor="#00C853"
                         CornerRadius="8"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnBackClicked"
                         Padding="8">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#x2630;" Color="White" Size="20" />
                </ImageButton.Source>
            </ImageButton>
            <Label Grid.Column="1"
                   Text="Détails du produits"
                   TextColor="Black"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="-40,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <!-- Product Image -->
                <Frame CornerRadius="10"
                       HasShadow="False"
                       Padding="0"
                       IsClippedToBounds="True"
                       HeightRequest="200">
                    <Image Source="{Binding SelectedProduct.Image}"
                           Aspect="AspectFill"
                           HeightRequest="200"
                           WidthRequest="400" />
                </Frame>

                <!-- Product Info -->
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="{Binding SelectedProduct.NameAndPrice}"
                           TextColor="Black"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    
                    <Label Text="{Binding SelectedProduct.QuantityText}"
                           TextColor="Black"
                           FontSize="14"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="{Binding SelectedProduct.Description}"
                           TextColor="Black"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           Margin="0,10,0,0"/>
                </VerticalStackLayout>

                <!-- Seller Info -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,20,0,0" BackgroundColor="#FAFAFA" Padding="15">
                    <Frame CornerRadius="25"
                           HeightRequest="50"
                           WidthRequest="50"
                           Padding="0"
                           IsClippedToBounds="True"
                           BackgroundColor="#00C853"
                           VerticalOptions="Center">
                        <Image Source="profile_icon.png" Aspect="AspectFill">
                             <Image.Source>
                                <FontImageSource Glyph="&#x1F464;" Color="White" Size="30" />
                            </Image.Source>
                        </Image>
                    </Frame>

                    <VerticalStackLayout Grid.Column="1" Spacing="5" Margin="15,0,0,0" VerticalOptions="Center">
                        <Label Text="{Binding SelectedProduct.SellerNameText}"
                               TextColor="Black"
                               FontSize="14" />
                        
                        <HorizontalStackLayout Spacing="5">
                            <Image Source="location_icon.png" HeightRequest="16" WidthRequest="16">
                                 <Image.Source>
                                    <FontImageSource Glyph="&#x1F4CD;" Color="#00C853" Size="16" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding SelectedProduct.SellerLocation}"
                                   TextColor="Black"
                                   FontSize="14"
                                   FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Buttons -->
                <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                    <Button Text="Contacter le vendeur"
                            BackgroundColor="#00FF40"
                            TextColor="Black"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            Clicked="OnContactSellerClicked"/>
                    
                    <Button Text="Ajouter au panier"
                            BackgroundColor="#E0E0E0"
                            TextColor="Black"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            Clicked="OnAddToCartClicked"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation (Mock) -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*,*"
              Padding="0,15"
              BackgroundColor="White">
            
            <ImageButton Grid.Column="0" Source="home_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F3E0;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>
            
            <ImageButton Grid.Column="1" Source="chat_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F4AC;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>
            
            <Grid Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                <ImageButton Source="cart_icon.png" HeightRequest="24" WidthRequest="24" Clicked="OnCartClicked">
                     <ImageButton.Source>
                        <FontImageSource Glyph="&#x1F6D2;" Color="#00C853" Size="24" />
                    </ImageButton.Source>
                </ImageButton>
                <Frame CornerRadius="10"
                       HeightRequest="20"
                       WidthRequest="20"
                       Padding="0"
                       BackgroundColor="Red"
                       HorizontalOptions="End"
                       VerticalOptions="Start"
                       Margin="10,-5,-5,0"
                       IsVisible="{Binding CartItemCount, Converter={StaticResource IntToBoolConverter}}">
                    <Label Text="{Binding CartItemCount}"
                           TextColor="White"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>
            </Grid>

            <ImageButton Grid.Column="3" Source="profile_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F464;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>

    </Grid>
</ContentPage>
