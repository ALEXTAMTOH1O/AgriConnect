<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgriConnect.ChatListPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#00C853" HeightRequest="60" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <ImageButton Source="back_icon.png"
                         BackgroundColor="Transparent"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnBackClicked"
                         VerticalOptions="Center">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#x2190;" Color="White" Size="24" />
                </ImageButton.Source>
            </ImageButton>

            <Label Grid.Column="1" 
                   Text="Discussions" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center" />
        </Grid>

        <!-- Chat List -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Conversations}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="5">
                        <Frame Grid.RowSpan="2" 
                               CornerRadius="25" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0" 
                               IsClippedToBounds="True" 
                               BackgroundColor="#E0E0E0"
                               VerticalOptions="Center">
                            <Image Source="profile_icon.png" Aspect="AspectFill">
                                <Image.Source>
                                    <FontImageSource Glyph="&#x1F464;" Color="Gray" Size="30" />
                                </Image.Source>
                            </Image>
                        </Frame>
                        
                        <Label Grid.Column="1" 
                               Text="{Binding SellerName}" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               TextColor="Black"
                               Margin="10,0,0,0"/>
                        
                        <Label Grid.Row="1" 
                               Grid.Column="1" 
                               Text="{Binding LastMessage}" 
                               FontSize="14" 
                               TextColor="Gray" 
                               LineBreakMode="TailTruncation"
                               Margin="10,0,0,0"/>
                        
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="#E0E0E0" VerticalOptions="End" Margin="0,5,0,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" HeightRequest="60" BackgroundColor="White">
            <BoxView Grid.ColumnSpan="4" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Start" />

            <ImageButton Grid.Column="0" Source="home_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" Clicked="OnHomeClicked">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F3E0;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>

            <ImageButton Grid.Column="1" Source="chat_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F4AC;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>

            <ImageButton Grid.Column="2" Source="cart_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" Clicked="OnCartClicked">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F6D2;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>

            <ImageButton Grid.Column="3" Source="profile_icon.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" Clicked="OnProfileClicked">
                 <ImageButton.Source>
                    <FontImageSource Glyph="&#x1F464;" Color="#00C853" Size="24" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>
    </Grid>
</ContentPage>
