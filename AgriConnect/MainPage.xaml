<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgriConnect.MainPage"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,40"
            Spacing="30"
            HorizontalOptions="Center"
            VerticalOptions="Start">

            <Label
                Text="Bienvenue sur AgriConnect"
                TextColor="#22C55E"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                FontSize="18" />

            <Label
                Text="Connectez-vous au marché agricole local"
                TextColor="#333333"
                HorizontalOptions="Start"
                FontSize="14" />

            <!-- Primary login button -->
            <Frame
                Padding="0"
                HasShadow="True"
                CornerRadius="4"
                BackgroundColor="#34D399"
                HorizontalOptions="Center"
                HeightRequest="40"
                WidthRequest="200">
                <Button
                    Text="Se connecter"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Clicked="OnLoginClicked"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </Frame>

            <!-- Google login button (visual only, pas de backend) -->
            <Frame
                Padding="8,6"
                HasShadow="False"
                CornerRadius="4"
                BackgroundColor="#E6E1E1"
                HorizontalOptions="Fill"
                HeightRequest="48">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <!-- Placeholder pour le logo Google -->
                    <Frame WidthRequest="28" HeightRequest="28" CornerRadius="14" BackgroundColor="White" Padding="0" VerticalOptions="Center">
                        <Label Text="G" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#2B2B2B" FontAttributes="Bold" />
                    </Frame>

                    <Label Text="connecter avec Google" VerticalOptions="Center" TextColor="#2B2B2B" />

                    <Button
                        x:Name="GoogleBtnOverlay"
                        BackgroundColor="Transparent"
                        Clicked="OnGoogleClicked"
                        HorizontalOptions="EndAndExpand"
                        VerticalOptions="Fill"
                        Opacity="0" />
                </HorizontalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
