<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AgriConnect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AgriConnect"
    Title="AgriConnect">

    <ShellContent
        Title="RoleSelection"
        ContentTemplate="{DataTemplate local:RoleSelectionPage}"
        Route="RoleSelectionPage" />

    <ShellContent
        Title="Products"
        ContentTemplate="{DataTemplate local:ProductsPage}"
        Route="ProductsPage" />

    <ShellContent
        Title="FarmerDashboard"
        ContentTemplate="{DataTemplate local:FarmerDashboardPage}"
        Route="FarmerDashboardPage" />

</Shell>
